<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Stylesheets -->
    <link rel="stylesheet" href="styles/style.css">

    <!-- Add DataTable Resources-->
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="https://cdn.datatables.net/3.1.4/js/dataTables.min.js"></script>
    <link rel="Stylesheet" href="https://cdn.datatables.net/3.1.4/css/dataTables.dataTables.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/4.1.1/css/responsive.dataTables.min.css">
    <script src="https://cdn.datatables.net/responsive/4.1.1/js/dataTables.responsive.min.js"></script>

    <!-- Favicon -->
    <link rel="icon" href="images/contact-form-favicon.png">

    <!-- Page Title -->
    <title>Admin</title>
</head>

<body>
    <div id="main-admin">
        <header id="header">
            <h1>Admin Dashboard</h1>
        </header>
        <div class="table-wrap">
            <table id="contact-table" class="display">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>LinkedIn</th>
                        <th>Company</th>
                        <th>Job Title</th>
                        <th>How we met</th>
                        <th>Other</th>
                        <th>Mail Format</th>
                        <th>Message</th>
                        <th>Date/Time</th>
                    </tr>
                </thead>
                <tbody>
                    <% contacts.forEach(contact=> { %>
                        <tr>
                            <td>
                                <%= contact.firstname %> <%= contact.lastname %>
                            </td>
                            <td>
                                <%= contact.email %>
                            </td>
                            <td>
                                <%= contact.linkedin %>
                            </td>
                            <td>
                                <%= contact.company %>
                            </td>
                            <td>
                                <%= contact.job %>
                            </td>
                            <td>
                                <%= contact.meeting %>
                            </td>
                            <td>
                                <%= contact.other %>
                            </td>
                            <td>
                                <%= contact.format %>
                            </td>
                            <td>
                                <%= contact.comments %>
                            </td>
                            <td>
                                <%= contact.timestamp.toLocaleString() %>
                            </td>
                        </tr>
                        <% }); %>
                </tbody>
            </table>
        </div>
        <script>
            new DataTable('#contact-table', { responsive: true });
        </script>
    </div>
</body>

</html>