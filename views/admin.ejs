<!DOCTYPE html>
<html lang="en">

<head>
    <!-- Stylesheets -->
    <link rel="stylesheet" href="styles/style.css">

    <!-- Add DataTable Resources-->
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="https://cdn.datatables.net/3.1.4/js/dataTables.min.js"></script>
    <link rel="Stylesheet" href="https://cdn.datatables.net/3.1.4/css/dataTables.dataTables.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/4.1.1/css/responsive.dataTables.min.css">
    <script src="https://cdn.datatables.net/responsive/4.1.1/js/dataTables.responsive.min.js"></script>

    <%- include('partials/title',{title:'Guestbook'}) %>
    <%- include('partials/header') %>
</head>

<body>
    <div id="main-admin">
        <header id="header">
            <h1>Guestbook Dashboard</h1>
        </header>
        <div class="table-wrap">
            <table id="contact-table" class="display">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>LinkedIn</th>
                        <th>Company</th>
                        <th>Job Title</th>
                        <th>How we met</th>
                        <th>Other</th>
                        <th>Mail Format</th>
                        <th>Message</th>
                        <th>Date/Time</th>
                    </tr>
                </thead>
                <tbody>
                    <% contacts.forEach(contact=> { %>
                        <tr>
                            <td>
                                <%= contact.first_name %> <%= contact.last_name %>
                            </td>
                            <td>
                                <%= contact.email %>
                            </td>
                            <td>
                                <%= contact.linkedin_url %>
                            </td>
                            <td>
                                <%= contact.company_name %>
                            </td>
                            <td>
                                <%= contact.job_title %>
                            </td>
                            <td>
                                <%= contact.first_meeting %>
                            </td>
                            <td>
                                <%= contact.other %>
                            </td>
                            <td>
                                <%= contact.email_format %>
                            </td>
                            <td>
                                <%= contact.comments %>
                            </td>
                            <td>
                                <%= contact.timestamp.toLocaleDateString() %>
                            </td>
                        </tr>
                        <% }); %>
                </tbody>
            </table>
        </div>
        <script>
            new DataTable('#contact-table', { responsive: true });
        </script>
    </div>
</body>

</html>